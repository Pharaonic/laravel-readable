{
    "name": "pharaonic/laravel-readable",
    "description": "Readable numbers, dates, durations and file sizes for Laravel, as static methods, helpers and Blade directives.",
    "keywords": [
        "php",
        "laravel",
        "human readable",
        "readable",
        "number format",
        "file size",
        "duration",
        "blade",
        "pharaonic"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Moamen Eltouny (Raggi)",
            "email": "raggigroup@gmail.com"
        }
    ],
    "support": {
        "docs": "https://pharaonic.dev/packages/laravel/readable",
        "issues": "https://github.com/Pharaonic/laravel-readable/issues",
        "source": "https://github.com/Pharaonic/laravel-readable"
    },
    "require": {
        "php": ">=8.0 <8.1",
        "illuminate/support": "^6.20",
        "illuminate/view": "^6.20",
        "pharaonic/php-readable": "~8.0.3"
    },
    "require-dev": {
        "laravel/pint": "^1.5",
        "orchestra/testbench": "^4.18",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6.33"
    },
    "suggest": {
        "ext-intl": "Required by Readable::getNumberToString() and the @ReadableNumberToString directive."
    },
    "autoload": {
        "psr-4": {
            "Pharaonic\\Laravel\\Readable\\": "src/"
        },
        "files": [
            "src/Helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Pharaonic\\Laravel\\Readable\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pharaonic\\Laravel\\Readable\\ReadableServiceProvider"
            ],
            "aliases": {
                "Readable": "Pharaonic\\Laravel\\Readable\\Readable"
            }
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "@php vendor/bin/pint",
        "format:check": "@php vendor/bin/pint --test",
        "security": "@composer audit",
        "check": [
            "@composer validate --strict",
            "@format:check",
            "@analyse",
            "@test",
            "@security"
        ]
    },
    "config": {
        "audit": {
            "abandoned": "report"
        },
        "policy": {
            "advisories": {
                "block": false,
                "ignore": {
                    "laravel/framework": "No fixed release within Laravel 6; the application chooses the framework release.",
                    "league/commonmark": "No fixed release within Laravel 6; the application chooses the framework release.",
                    "league/flysystem": "No fixed release within Laravel 6; the application chooses the framework release.",
                    "symfony/http-foundation": "No fixed release within Laravel 6; the application chooses the framework release.",
                    "symfony/process": "No fixed release within Laravel 6; the application chooses the framework release.",
                    "symfony/routing": "No fixed release within Laravel 6; the application chooses the framework release."
                }
            }
        },
        "sort-packages": true
    },
    "prefer-stable": true
}
