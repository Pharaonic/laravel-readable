{
    "name": "pharaonic/laravel-readable",
    "description": "Readable numbers, dates, durations and file sizes for Laravel, as static methods, helpers and Blade directives.",
    "keywords": [
        "php",
        "laravel",
        "human readable",
        "readable",
        "number format",
        "file size",
        "duration",
        "blade",
        "pharaonic"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Moamen Eltouny (Raggi)",
            "email": "raggigroup@gmail.com"
        }
    ],
    "support": {
        "docs": "https://pharaonic.dev/packages/laravel/readable",
        "issues": "https://github.com/Pharaonic/laravel-readable/issues",
        "source": "https://github.com/Pharaonic/laravel-readable"
    },
    "require": {
        "php": ">=8.1 <8.4",
        "illuminate/support": "^10.0",
        "illuminate/view": "^10.0",
        "pharaonic/php-readable": "~8.1.2 || ~8.2.2 || ~8.3.2"
    },
    "require-dev": {
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^8.0",
        "pestphp/pest": "^1.23",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6.33"
    },
    "suggest": {
        "ext-intl": "Required by Readable::getNumberInWords(), readable_number_in_words() and @readableNumberInWords for locales other than English."
    },
    "autoload": {
        "psr-4": {
            "Pharaonic\\Laravel\\Readable\\": "src/"
        },
        "files": [
            "src/Helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Pharaonic\\Laravel\\Readable\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pharaonic\\Laravel\\Readable\\ReadableServiceProvider"
            ],
            "aliases": {
                "Readable": "Pharaonic\\Laravel\\Readable\\Readable"
            }
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "@php vendor/bin/pint",
        "format:check": "@php vendor/bin/pint --test",
        "security": "@composer audit",
        "check": [
            "@composer validate --strict",
            "@format:check",
            "@analyse",
            "@test",
            "@security"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "audit": {
            "abandoned": "report"
        },
        "policy": {
            "advisories": {
                "block": false,
                "ignore": {
                    "laravel/framework": "No fixed release within Laravel 10; the application chooses the framework release."
                }
            }
        },
        "sort-packages": true
    },
    "prefer-stable": true
}
